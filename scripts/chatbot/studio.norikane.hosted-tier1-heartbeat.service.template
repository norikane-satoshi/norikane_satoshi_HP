[Unit]
Description=Norikane HP hosted Tier1 heartbeat
Wants=network-online.target hosted-notion-ai-worker.service hosted-worker-chrome.service
After=network-online.target hosted-notion-ai-worker.service hosted-worker-chrome.service

[Service]
Type=oneshot
WorkingDirectory=%h/norikane_satoshi_HP
EnvironmentFile=%h/.config/norikane/hosted-tier1-heartbeat.env
Environment=CHATBOT_HOSTED_TIER1_HEARTBEAT_GENERATE_INTERVAL_MS=600000
Environment=CHATBOT_HOSTED_TIER1_HEARTBEAT_FAILURE_THRESHOLD=1
Environment=CHATBOT_HOSTED_TIER1_HEARTBEAT_TRANSIENT_GENERATE_FAILURE_THRESHOLD=3
ExecStart=%h/norikane_satoshi_HP/node_modules/.bin/tsx %h/norikane_satoshi_HP/scripts/chatbot/hosted-tier1-heartbeat.ts
